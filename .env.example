# Optional. Without a key the app uses an explicitly labeled local demo parser.
# Keep this server-side; never use a VITE_ prefix for secrets.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=qwen-3.8-27b
PORT=3001

# Optional OpenAI comparison baseline. Keep credentials server-side.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# GPT-5.6 Sol Standard and Ultrafast profiles both use OPENAI_API_KEY.
# Ultrafast additionally requires account access; a Cerebras key does not enable it.
